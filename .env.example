# Environment Variables Example

# Environment Type (development, uat, production)
REACT_APP_ENV=development

# API Base URLs (will be selected based on REACT_APP_ENV)
# Development: http://localhost:3000/api
# UAT: https://uat-api.your-domain.com/api
# Production: https://api.your-domain.com/api

# App Configuration
REACT_APP_NAME=WMS Rebirth
REACT_APP_VERSION=1.0.0

# =====================================
# Secure Storage Configuration
# =====================================
# Secret key for encrypting localStorage data
# IMPORTANT: Change this to a strong, unique value in production
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REACT_APP_STORAGE_SECRET=wms-rebirth-secret-key-2026-change-me-in-production

# =====================================
# Instructions:
# =====================================
# 1. Copy this file to .env
# 2. Update REACT_APP_STORAGE_SECRET with your own secret key
# 3. Never commit .env to Git (add to .gitignore)
# 4. For production, use environment variables from your hosting service
